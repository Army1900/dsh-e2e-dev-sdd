{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://army1900.github.io/dsh-e2e-dev-sdd/schemas/run.schema.json",
  "title": "DSH SDD Stage Run",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "uid", "stage", "artifactUid", "status", "startedAt", "updatedAt", "inputArtifactUids", "sourceUids"],
  "properties": {
    "schema": { "const": "dsh-sdd/run@1" }, "uid": { "type": "string", "format": "uuid" },
    "stage": { "enum": ["requirements", "prototype", "architecture", "specification", "development"] },
    "artifactUid": { "type": "string" }, "sessionId": { "type": "string" },
    "status": { "enum": ["active", "syncing", "ready-for-review", "completed"] },
    "startedAt": { "type": "string", "format": "date-time" }, "updatedAt": { "type": "string", "format": "date-time" }, "lastSyncedAt": { "type": "string", "format": "date-time" },
    "inputArtifactUids": { "type": "array", "items": { "type": "string" } }, "sourceUids": { "type": "array", "items": { "type": "string" } },
    "codeReferences": { "type": "array", "items": { "$ref": "#/$defs/codeReference" } },
    "previousRunUid": { "type": "string" }
  },
  "$defs": {
    "codeReference": {
      "type": "object", "additionalProperties": false,
      "required": ["repositoryId", "source", "sourceKind", "baseBranch", "available"],
      "properties": {
        "repositoryId": { "type": "string" }, "source": { "type": "string" },
        "sourceKind": { "enum": ["local", "remote"] }, "baseBranch": { "type": "string" },
        "baseCommit": { "type": "string" }, "path": { "type": "string" },
        "available": { "type": "boolean" }, "error": { "type": "string" }
      }
    }
  }
}
