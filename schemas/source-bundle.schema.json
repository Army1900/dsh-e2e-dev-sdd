{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://army1900.github.io/dsh-e2e-dev-sdd/schemas/source-bundle.schema.json",
  "title": "DSH SDD Source Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "uid", "provider", "kind", "externalKey", "title", "fetchedAt", "items", "relations"],
  "properties": {
    "schema": { "const": "dsh-sdd/source-bundle@1" },
    "uid": { "type": "string", "minLength": 1 },
    "provider": { "type": "string", "minLength": 1 },
    "kind": { "type": "string", "minLength": 1 },
    "externalKey": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "fetchedAt": { "type": "string", "format": "date-time" },
    "root": { "$ref": "source.schema.json" },
    "items": { "type": "array", "minItems": 1, "items": { "$ref": "source.schema.json" } },
    "relations": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["from", "to", "type"],
        "properties": { "from": { "type": "string" }, "to": { "type": "string" }, "type": { "type": "string" } }
      }
    }
  }
}
