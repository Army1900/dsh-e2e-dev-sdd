{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://army1900.github.io/dsh-e2e-dev-sdd/schemas/artifact-template.schema.json",
  "title": "DSH SDD Project Artifact Template",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "stage", "version", "documentName", "maintenanceGuide", "requiredSections"],
  "properties": {
    "schema": { "const": "dsh-sdd/artifact-template@1" },
    "stage": { "enum": ["requirements", "prototype", "architecture", "specification", "development"] },
    "version": { "type": "string", "minLength": 1 },
    "documentName": { "type": "string", "minLength": 1 },
    "maintenanceGuide": { "type": "string", "minLength": 1 },
    "requiredSections": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  }
}
