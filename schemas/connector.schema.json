{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://army1900.github.io/dsh-e2e-dev-sdd/schemas/connector.schema.json",
  "title": "DSH SDD Command Connector",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "type", "command"],
  "properties": {
    "schema": { "const": "dsh-sdd/connector@1" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "type": { "const": "command" },
    "command": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 300000 },
    "environment": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" }
    }
  }
}
