{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://army1900.github.io/dsh-e2e-dev-sdd/schemas/work-item.schema.json",
  "title": "DSH SDD Work Item",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "uid", "key", "title", "kind", "provider", "bundleKey", "status", "createdAt", "updatedAt"],
  "properties": {
    "schema": { "const": "dsh-sdd/work-item@1" },
    "uid": { "type": "string", "format": "uuid" },
    "key": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "kind": { "type": "string", "minLength": 1 },
    "provider": { "type": "string", "minLength": 1 },
    "bundleKey": { "type": "string", "minLength": 1 },
    "sourceUid": { "type": "string" },
    "bundleSourceUid": { "type": "string" },
    "executionMode": { "enum": ["standalone", "attached"] },
    "parentWorkItemUid": { "type": "string", "format": "uuid" },
    "status": { "enum": ["active", "change-pending", "removed-pending", "completed"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "relations": {
      "type": "array",
      "items": {
        "type": "object", "required": ["from", "to", "type"],
        "properties": { "from": { "type": "string" }, "to": { "type": "string" }, "type": { "type": "string" } }
      }
    },
    "repositoryScope": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" } },
    "developmentTargets": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" } },
    "developmentTargetDetails": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "stageApplicability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requirements": { "$ref": "#/$defs/stageApplicability" },
        "prototype": { "$ref": "#/$defs/stageApplicability" },
        "architecture": { "$ref": "#/$defs/stageApplicability" },
        "specification": { "$ref": "#/$defs/stageApplicability" },
        "development": { "$ref": "#/$defs/stageApplicability" }
      }
    },
    "openSpec": {
      "type": "object", "additionalProperties": false, "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "repositoryId": { "type": "string" },
        "path": { "type": "string" },
        "schema": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "changeId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
      }
    },
    "change": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "detectedAt", "changedPaths", "reviewRequiredStages"],
      "properties": {
        "kind": { "enum": ["added", "modified", "removed"] },
        "detectedAt": { "type": "string", "format": "date-time" },
        "changedPaths": { "type": "array", "items": { "type": "string" } },
        "previousSourceUid": { "type": "string" },
        "reviewRequiredStages": { "type": "array", "items": { "enum": ["requirements", "prototype", "architecture", "specification", "development"] } }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "executionMode": { "const": "attached" } }, "required": ["executionMode"] },
      "then": { "required": ["parentWorkItemUid"] }
    }
  ],
  "$defs": {
    "stageApplicability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "updatedAt"],
      "properties": {
        "status": { "enum": ["applicable", "not-applicable"] },
        "reason": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
